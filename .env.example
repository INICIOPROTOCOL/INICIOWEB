# =============================================================================
# Variables VITE_* — copiar a .env y ajustar (no commitear secretos reales).
# =============================================================================

# -----------------------------------------------------------------------------
# API propia (backend)
# -----------------------------------------------------------------------------
# Base URL de la API REST (incluye el path /api si corresponde a tu despliegue).
# Estándar del proyecto: VITE_API_URL
# Varios módulos usan http://localhost:3000/api como fallback si esta variable falta.
VITE_API_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# Meta Pixel (opcional)
# -----------------------------------------------------------------------------
# Si está vacío o no definida, el tracking de Meta Pixel no se inicializa.
# Reemplazar por tu Pixel ID numérico (Meta Events Manager).
VITE_META_PIXEL_ID=

# -----------------------------------------------------------------------------
# Google Analytics 4 (opcional)
# -----------------------------------------------------------------------------
# ID de medición tipo G-XXXXXXXXXX. Usado por el código de analítica y la plantilla HTML.
VITE_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Supabase (opcional — típico del panel admin / uploads)
# -----------------------------------------------------------------------------
# Solo claves anon públicas del proyecto Supabase. Nunca service role en el frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
